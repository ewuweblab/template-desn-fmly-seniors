---
const { name, image, favorite_emoji, github_permalink, github_profile, codepen_profile } = Astro.props;
---

<div class="card">
  <img src={image} alt={name} loading="lazy" />
  <div class="card-name">
    <span class="card-emoji">{favorite_emoji}</span> {name}
  </div>
  <div class="card-links">
    <a href={github_permalink} target="_blank" rel="noopener">Portfolio</a>
    <a href={github_profile} target="_blank" rel="noopener">GitHub</a>
    <a href={codepen_profile} target="_blank" rel="noopener">CodePen</a>
  </div>
</div>

<style>
  .card {
    border: 0;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-right: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
  }

  .card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    background: #f0f0f0;
  }

  .card-name {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .card-emoji {
    font-size: 1.1rem;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
  }

  .card-links a {
    font-size: 0.75rem;
    color: #555;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    line-height: 1;
  }

  .card-links a:hover {
    color: #000;
  }
</style>
